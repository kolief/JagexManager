<Window x:Class="JagexManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:JagexManager"
        xmlns:core="clr-namespace:JagexManager;assembly=JagexManager.Core"
        Title="JagexManager"
        Width="440" Height="640" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Window.CommandBindings>
        <CommandBinding Command="Find" Executed="FindCharacter" />
    </Window.CommandBindings>

    <Window.Resources>
        <Thickness x:Key="ButtonPadding">8</Thickness>

        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>

        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource HeadingFont}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>

        <Style x:Key="Badge" TargetType="Grid">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextElement.FontSize" Value="10" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Member}" Value="True">
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Membership}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Text" Text="{TemplateBinding Content}" Background="Transparent" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="16,8,12,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        </Style>

        <Style x:Key="Section" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16,12" />
        </Style>

        <DataTemplate x:Key="IconLabel">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                           Style="{StaticResource Icon}" Margin="0,0,8,0" />
                <AccessText Text="{Binding}" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="Grip" TargetType="Thumb">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Cursor" Value="SizeNS" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" Padding="8">
                            <UniformGrid Rows="3" Columns="2" Width="10" Height="15" UseLayoutRounding="True">
                                <UniformGrid.Resources>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Width" Value="3" />
                                        <Setter Property="Height" Value="3" />
                                        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </Style>
                                </UniformGrid.Resources>
                                <Rectangle /><Rectangle />
                                <Rectangle /><Rectangle />
                                <Rectangle /><Rectangle />
                            </UniformGrid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource HeadingFont}" />
            <Setter Property="FontSize" Value="{DynamicResource TabSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource Strong}" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Background="Transparent">
                            <ContentPresenter />
                            <Border x:Name="Mark" Height="4" CornerRadius="2" Margin="0,4,0,0" Background="Transparent" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter TargetName="Mark" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Padding="20,8" BorderThickness="0,1,0,0" Visibility="Collapsed"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <TextBlock x:Name="Status" Style="{StaticResource Note}" AutomationProperties.LiveSetting="Polite" />
        </Border>

        <Border x:Name="UpdateBar" DockPanel.Dock="Bottom" Padding="20,8" BorderThickness="0,1,0,0" Visibility="Collapsed"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Click="DismissUpdate" Margin="12,0,0,0" Style="{StaticResource Link}"
                        Content="Not now" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Click="OpenUpdate" Margin="12,0,0,0" Style="{StaticResource Link}"
                        Content="View release" VerticalAlignment="Center" />
                <TextBlock x:Name="UpdateText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>

        <DockPanel DockPanel.Dock="Top" Margin="20,16,20,12">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <RadioButton x:Name="AccountsTab" Content="Accounts" Style="{StaticResource Tab}" IsChecked="True" />
                <RadioButton x:Name="SettingsTab" Content="Settings" Style="{StaticResource Tab}" />
            </StackPanel>
            <Button Padding="{StaticResource ButtonPadding}" Content="_Add account" Tag="&#xE710;" ContentTemplate="{StaticResource IconLabel}" Click="SignIn"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource AccentButtonStyle}"
                    Visibility="{Binding IsChecked, ElementName=AccountsTab, Converter={StaticResource Visible}}" />
        </DockPanel>

        <Grid>
            <Grid Visibility="{Binding IsChecked, ElementName=AccountsTab, Converter={StaticResource Visible}}">
                <StackPanel VerticalAlignment="Center" Margin="20,0,20,20"
                            Visibility="{Binding HasItems, ElementName=List, Converter={StaticResource Collapsed}}">
                    <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="40" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="No accounts yet" FontSize="16" FontWeight="{DynamicResource Strong}"
                               Margin="0,12,0,4" HorizontalAlignment="Center" />
                    <TextBlock TextAlignment="Center" Style="{StaticResource Note}"
                               Text="Add your Jagex account and each of its characters gets a Play button." />
                </StackPanel>

                <DockPanel>
                    <Grid x:Name="SearchArea" DockPanel.Dock="Top" Margin="20,0,20,12" Visibility="Collapsed">
                        <TextBox x:Name="SearchBox" TextChanged="Search" KeyDown="ClearSearch" MaxLength="{x:Static app:MainWindow.SearchLimit}"
                                 AutomationProperties.Name="Search characters" AutomationProperties.AcceleratorKey="Ctrl+F" ToolTip="Ctrl+F" />
                        <TextBlock Text="Search characters" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0">
                        <StackPanel>
                            <Border x:Name="GroupsCard" Style="{StaticResource Card}" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Groups" FontSize="16" FontWeight="{DynamicResource Strong}" Margin="16,12,12,12" />
                                    <ItemsControl x:Name="GroupList" IsTabStop="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type core:Group}">
                                                <Border Style="{StaticResource Row}" MouseRightButtonUp="OfferGroup">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                            <Button Padding="{StaticResource ButtonPadding}" MinWidth="64" Click="PlayGroup"
                                                                    Content="Play" Tag="&#xE768;" ContentTemplate="{StaticResource IconLabel}"
                                                                    Style="{DynamicResource AccentButtonStyle}"
                                                                    AutomationProperties.Name="{Binding Name, StringFormat=Play group {0}}" />
                                                            <Button Padding="{StaticResource ButtonPadding}" Margin="4,0,0,0" Click="OfferGroupOptions" VerticalAlignment="Stretch"
                                                                    ToolTip="Group options"
                                                                    AutomationProperties.Name="{Binding Name, StringFormat=Options for {0}}">
                                                                <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" />
                                                            </Button>
                                                        </StackPanel>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="NoMatch" Style="{StaticResource Note}" TextAlignment="Center" Margin="0,24"
                                       Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />

                            <ItemsControl x:Name="List" IsTabStop="False"
                                          MouseMove="Drag" MouseLeftButtonUp="EndDrag" LostMouseCapture="Settle">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type core:AccountView}">
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Matched}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <DockPanel Margin="8,12,12,12">
                                                    <Thumb x:Name="Grip" DockPanel.Dock="Left" Style="{StaticResource Grip}"
                                                           PreviewMouseLeftButtonDown="Grab" KeyDown="Nudge"
                                                           ToolTip="Drag, or press Up or Down, to reorder"
                                                           AutomationProperties.Name="{Binding Name, StringFormat=Reorder {0}}" />
                                                    <Button Padding="{StaticResource ButtonPadding}" DockPanel.Dock="Right" Click="Remove" Margin="8,0,0,0"
                                                            VerticalAlignment="Center" ToolTip="Remove account"
                                                            AutomationProperties.Name="{Binding Name, StringFormat=Remove {0}}">
                                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" />
                                                    </Button>
                                                    <ContentControl DockPanel.Dock="Right" Focusable="False" VerticalAlignment="Center"
                                                                    Visibility="{Binding Source={x:Static core:Launcher.Installed}, Converter={StaticResource Visible}}">
                                                        <Button Padding="{StaticResource ButtonPadding}" Click="OpenLauncher" Margin="8,0,0,0"
                                                                ToolTip="Open in the Jagex Launcher"
                                                                AutomationProperties.Name="{Binding Name, StringFormat=Open {0} in the Jagex Launcher}"
                                                                Visibility="{Binding Expired, Converter={StaticResource Collapsed}}">
                                                            <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="14" />
                                                        </Button>
                                                    </ContentControl>
                                                    <Button Padding="{StaticResource ButtonPadding}" DockPanel.Dock="Right" Click="PlayAll" Margin="8,0,0,0"
                                                            VerticalAlignment="Center" ToolTip="Play all shown characters"
                                                            AutomationProperties.Name="{Binding Name, StringFormat=Play all shown characters on {0}}"
                                                            Visibility="{Binding Expired, Converter={StaticResource Collapsed}}">
                                                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="14" />
                                                    </Button>
                                                    <Button Padding="{StaticResource ButtonPadding}" DockPanel.Dock="Right" Click="Refresh" Margin="8,0,0,0"
                                                            VerticalAlignment="Center" ToolTip="Check for new characters"
                                                            AutomationProperties.Name="{Binding Name, StringFormat=Check {0} for new characters}"
                                                            Visibility="{Binding Expired, Converter={StaticResource Collapsed}}">
                                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" />
                                                    </Button>
                                                    <Button Padding="{StaticResource ButtonPadding}" DockPanel.Dock="Right" Content="Sign in again" Click="SignIn" Margin="8,0,0,0"
                                                            VerticalAlignment="Center" Style="{DynamicResource AccentButtonStyle}"
                                                            AutomationProperties.Name="{Binding Name, StringFormat=Sign in again for {0}}"
                                                            Visibility="{Binding Expired, Converter={StaticResource Visible}}" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="{DynamicResource Strong}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding Expired, Converter={StaticResource Collapsed}}" />
                                                        <TextBlock Text="Session ended. Sign in again to play." TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                                   Visibility="{Binding Expired, Converter={StaticResource Visible}}" />
                                                    </StackPanel>
                                                </DockPanel>

                                                <ItemsControl ItemsSource="{Binding Characters}" IsTabStop="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type core:CharacterView}">
                                                            <Border MouseRightButtonUp="OfferCharacter">
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource Row}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Visible}" Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Hidden}" Value="True">
                                                                                <Setter Property="Opacity" Value="0.6" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <DockPanel>
                                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                        <Button Padding="{StaticResource ButtonPadding}" MinWidth="64" Click="Play"
                                                                                Content="Play" Tag="&#xE768;" ContentTemplate="{StaticResource IconLabel}"
                                                                                IsEnabled="{Binding Ready}" Style="{DynamicResource AccentButtonStyle}"
                                                                                AutomationProperties.Name="{Binding Name, StringFormat=Play {0}}"
                                                                                Visibility="{Binding Running, Converter={StaticResource Collapsed}}" />
                                                                        <Button Padding="{StaticResource ButtonPadding}" Margin="0,0,4,0" Click="FocusClient" VerticalAlignment="Stretch"
                                                                                ToolTip="Show the game window"
                                                                                AutomationProperties.Name="{Binding Name, StringFormat=Show the game window for {0}}"
                                                                                Visibility="{Binding Running, Converter={StaticResource Visible}}">
                                                                            <TextBlock Text="&#xE7C4;" Style="{StaticResource Icon}" />
                                                                        </Button>
                                                                        <Button Padding="{StaticResource ButtonPadding}" MinWidth="64" Click="Stop"
                                                                                Content="Stop" Tag="&#xE71A;" ContentTemplate="{StaticResource IconLabel}"
                                                                                AutomationProperties.Name="{Binding Name, StringFormat=Stop {0}}"
                                                                                Visibility="{Binding Running, Converter={StaticResource Visible}}" />
                                                                        <Button Padding="{StaticResource ButtonPadding}" Margin="4,0,0,0" Click="OfferClients" VerticalAlignment="Stretch"
                                                                                ToolTip="Choose a client" IsEnabled="{Binding Ready}"
                                                                                AutomationProperties.Name="{Binding Name, StringFormat=Choose a client for {0}}"
                                                                                Visibility="{Binding Running, Converter={StaticResource Collapsed}}">
                                                                            <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" />
                                                                        </Button>
                                                                    </StackPanel>

                                                                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,12,0"
                                                                             VerticalAlignment="Center">
                                                                        <Ellipse.Style>
                                                                            <Style TargetType="Ellipse">
                                                                                <Setter Property="Fill" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Running}" Value="True">
                                                                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Ellipse.Style>
                                                                    </Ellipse>

                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                                            <Grid Style="{StaticResource Badge}" ToolTip="{Binding MembershipNote}">
                                                                                <Border CornerRadius="3" Opacity="0.16"
                                                                                        Background="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
                                                                                <TextBlock Text="{Binding Membership}" Margin="5,1" />
                                                                            </Grid>
                                                                            <TextBlock Text="{Binding MembershipLeft}" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Lapsing}" Value="True">
                                                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis"
                                                                                   ToolTip="{Binding Detail}">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Running}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <TextBlock Text="Running"
                                                                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                                                   Visibility="{Binding Running, Converter={StaticResource Visible}}" />
                                                                    </StackPanel>
                                                                </DockPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource Row}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HiddenOffered}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Button Click="ToggleShowHidden" Content="{Binding HiddenLink}" HorizontalAlignment="Left"
                                                            Style="{StaticResource Link}" FontSize="12" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0"
                          Visibility="{Binding IsChecked, ElementName=SettingsTab, Converter={StaticResource Visible}}">
                <StackPanel>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Game client" Style="{StaticResource Heading}" />
                            <ComboBox x:Name="ClientChoice" HorizontalAlignment="Stretch" SelectionChanged="ChangeClient"
                                      ToolTip="The client Play starts, unless a character has its own"
                                      AutomationProperties.Name="Default game client"
                                      AutomationProperties.HelpText="{Binding Text, ElementName=ClientStatus}" />
                            <TextBlock x:Name="ClientStatus" Margin="0,8,0,0" Style="{StaticResource Secondary}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Padding="{StaticResource ButtonPadding}" Content="_Add client…" Click="AddClient"
                                        ToolTip="Add any other client by choosing its program" />
                                <Button x:Name="RemoveButton" Padding="{StaticResource ButtonPadding}" Content="_Remove"
                                        Click="RemoveClient" Margin="8,0,0,0"
                                        AutomationProperties.Name="Remove this client" />
                            </StackPanel>

                            <TextBlock x:Name="OptionsLabel" Text="Launch options" Margin="0,12,0,4" />
                            <TextBox x:Name="OptionsBox" LostFocus="LeaveOptions" KeyDown="SubmitOptions"
                                     ToolTip="Only add options you understand: they can change what the client loads"
                                     AutomationProperties.LabeledBy="{Binding ElementName=OptionsLabel}" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Note}"
                                       Text="Extra client options, such as --profile=Main." />

                            <DockPanel Margin="0,12,0,0">
                                <ComboBox x:Name="GapChoice" DockPanel.Dock="Right" MinWidth="160" SelectedValuePath="Tag"
                                          SelectionChanged="ChangeGap"
                                          AutomationProperties.LabeledBy="{Binding ElementName=GapLabel}"
                                          AutomationProperties.HelpText="{Binding Text, ElementName=GapNote}" />
                                <TextBlock x:Name="GapLabel" Text="Wait between clients" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock x:Name="GapNote" Margin="0,4,0,0" Style="{StaticResource Note}"
                                       Text="Play all and groups start one client at a time, waiting this long in between." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Appearance" Style="{StaticResource Heading}" />
                            <DockPanel>
                                <ComboBox x:Name="ThemeChoice" DockPanel.Dock="Right" MinWidth="160" SelectedValuePath="Tag"
                                          SelectionChanged="ChangeTheme"
                                          AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabel}">
                                    <ComboBoxItem Content="RuneLite" Tag="{x:Static core:Theme.RuneLite}" />
                                    <ComboBoxItem Content="Use Windows setting" Tag="{x:Static core:Theme.System}" />
                                    <ComboBoxItem Content="Light" Tag="{x:Static core:Theme.Light}" />
                                    <ComboBoxItem Content="Dark" Tag="{x:Static core:Theme.Dark}" />
                                </ComboBox>
                                <TextBlock x:Name="ThemeLabel" Text="Theme" VerticalAlignment="Center" />
                            </DockPanel>

                            <DockPanel Margin="0,8,0,0">
                                <ComboBox x:Name="FontChoice" DockPanel.Dock="Right" MinWidth="160"
                                          SelectionChanged="ChangeFont"
                                          AutomationProperties.LabeledBy="{Binding ElementName=FontLabel}">
                                    <ComboBoxItem x:Name="RuneScapeFont" Content="RuneScape"
                                                  ToolTip="Copied from your RuneLite install, so it needs RuneLite"
                                                  ToolTipService.ShowOnDisabled="True" />
                                    <ComboBoxItem x:Name="DefaultFont" Content="Default" />
                                </ComboBox>
                                <TextBlock x:Name="FontLabel" Text="Font" VerticalAlignment="Center" />
                            </DockPanel>

                            <DockPanel Margin="0,8,0,0">
                                <ComboBox x:Name="SortChoice" DockPanel.Dock="Right" MinWidth="160" SelectedValuePath="Tag"
                                          SelectionChanged="ChangeSort"
                                          AutomationProperties.LabeledBy="{Binding ElementName=SortLabel}">
                                    <ComboBoxItem Content="Jagex order" Tag="{x:Static core:Sort.Jagex}" />
                                    <ComboBoxItem Content="Last played" Tag="{x:Static core:Sort.Played}" />
                                </ComboBox>
                                <TextBlock x:Name="SortLabel" Text="Sort characters" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="General" Style="{StaticResource Heading}" />
                            <CheckBox x:Name="AutostartBox" Content="Start with Windows" Click="ChangeAutostart"
                                      AutomationProperties.HelpText="Starts minimised when you sign in to Windows" />
                            <CheckBox x:Name="TrayBox" Content="Minimise to the notification area" Click="ChangeTray" Margin="0,4,0,0" />
                            <CheckBox x:Name="WarnBox" Content="Warn before a membership runs out" Click="ChangeWarn" Margin="0,4,0,0"
                                      AutomationProperties.HelpText="Shows a notice when a membership that does not renew is about to end" />
                            <CheckBox x:Name="UpdatesBox" Content="Check for new versions" Click="ChangeUpdates" Margin="0,4,0,0"
                                      AutomationProperties.HelpText="{Binding Text, ElementName=UpdatesNote}" />
                            <TextBlock x:Name="UpdatesNote" Margin="0,4,0,0" Style="{StaticResource Note}"
                                       Text="Asks GitHub for the latest release when JagexManager starts. Nothing is downloaded by itself." />
                        </StackPanel>
                    </Border>

                    <Border x:Name="LauncherSection" Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Jagex Launcher" Style="{StaticResource Heading}" />
                            <DockPanel>
                                <Button Padding="{StaticResource ButtonPadding}" DockPanel.Dock="Right" Content="_Sign out" Click="SignOutLauncher"
                                        Margin="12,0,0,0" VerticalAlignment="Center"
                                        AutomationProperties.Name="Sign out of the Jagex Launcher"
                                        AutomationProperties.HelpText="{Binding Text, ElementName=LauncherNote}" />
                                <TextBlock x:Name="LauncherNote" Style="{StaticResource Note}" VerticalAlignment="Center"
                                           Text="Closes the launcher if it is open and signs it out. Your accounts stay here." />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Storage" Style="{StaticResource Heading}" />
                            <TextBlock Style="{StaticResource Note}"
                                       Text="Accounts are encrypted for your Windows user on this PC. Passwords are never stored." />
                            <DockPanel Margin="0,8,0,0">
                                <Button Padding="{StaticResource ButtonPadding}" DockPanel.Dock="Right" Content="_Open folder" Click="OpenFolder" Margin="12,0,0,0"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static app:App.DataFolder}" ToolTip="{x:Static app:App.DataFolder}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
