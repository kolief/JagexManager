<Window x:Class="JagexManager.Prompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=Answer}"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="20,16,20,20">
        <TextBlock x:Name="Question" Margin="0,0,0,8" TextWrapping="Wrap" />
        <TextBox x:Name="Answer" AutomationProperties.LabeledBy="{Binding ElementName=Question}"
                 AutomationProperties.HelpText="{Binding Text, ElementName=Note}" />
        <TextBlock x:Name="Note" Margin="0,6,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" Padding="8" MinWidth="80" IsDefault="True" Click="Save"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Cancel" Padding="8" MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
