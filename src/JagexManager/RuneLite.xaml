<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="DarkerGray">#1E1E1E</Color>
    <Color x:Key="DarkGray">#282828</Color>
    <Color x:Key="MediumGray">#4D4D4D</Color>
    <Color x:Key="LightGray">#A5A5A5</Color>
    <Color x:Key="Orange">#DC8A00</Color>
    <Color x:Key="Green">#37F046</Color>

    <Color x:Key="ControlGray">#363636</Color>
    <Color x:Key="ControlGrayHover">#414141</Color>
    <Color x:Key="OrangeHover">#F09A0A</Color>
    <Color x:Key="OrangePressed">#B87400</Color>
    <Color x:Key="Red">#FF5A5A</Color>
    <Color x:Key="Yellow">#FFC83D</Color>
    <Color x:Key="OffWhite">#F2F2F2</Color>

    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource DarkerGray}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource DarkGray}" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource ControlGray}" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="{StaticResource MediumGray}" />

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource OffWhite}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource LightGray}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource MediumGray}" />

    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource Orange}" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="{StaticResource Green}" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="{StaticResource Red}" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="{StaticResource Yellow}" />

    <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource Orange}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource OrangeHover}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource OrangePressed}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="{StaticResource MediumGray}" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="{StaticResource DarkerGray}" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{StaticResource DarkerGray}" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{StaticResource DarkerGray}" />
    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="{StaticResource LightGray}" />

    <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource ControlGray}" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource ControlGrayHover}" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource DarkGray}" />
    <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource OffWhite}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource MediumGray}" />

    <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource ControlGray}" />
    <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource OffWhite}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource DarkGray}" />
    <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="{StaticResource Orange}" />

    <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource DarkerGray}" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource DarkerGray}" />
    <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource OffWhite}" />
    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="{StaticResource LightGray}" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource Orange}" />
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource Orange}" />

    <SolidColorBrush x:Key="CheckBoxForegroundUnchecked" Color="{StaticResource OffWhite}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="{StaticResource DarkerGray}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource Orange}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource OrangeHover}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{StaticResource OrangePressed}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{StaticResource Orange}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{StaticResource OrangeHover}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="{StaticResource OrangePressed}" />
</ResourceDictionary>
